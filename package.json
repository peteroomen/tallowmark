{
  "name": "tallowmark",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A turn-based grid roguelite with persistent town metaprogression",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/setup-assets.mjs",
    "prebuild": "node scripts/setup-assets.mjs",
    "pretest:e2e": "node scripts/setup-assets.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "phaser": "^3.80.1",
    "rot-js": "^2.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.10.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
